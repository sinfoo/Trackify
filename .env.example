# Copy to .env. All values are safe local defaults. Never commit .env.
APP_ENV=development
# SQLite by default for zero-setup local dev; docker-compose overrides with PostgreSQL.
DATABASE_URL=sqlite:///./fintech.db
CORS_ORIGINS=http://localhost:3000

# Auth (CHANGE in any shared environment: 32+ random chars)
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# AI providers: mock (deterministic, no key) | anthropic | openai. Keys stay server-side.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Empty = provider default (claude-opus-5-5 for anthropic, gpt-5 for openai)
DEFAULT_MODEL=
LLM_TIMEOUT_SECONDS=20

# Payment simulation (no live mode exists)
HIGH_VALUE_THRESHOLD=2000
VELOCITY_MAX_ATTEMPTS=3
VELOCITY_WINDOW_MINUTES=10
FAILED_ATTEMPTS_THRESHOLD=3
APPROVAL_TTL_HOURS=24

# Demo accounts password
DEMO_PASSWORD=Demo!2026
POSTGRES_PASSWORD=fintech-dev

# Web (apps/web)
API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
